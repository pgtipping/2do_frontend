VITE_API_URL=http://localhost:5000
VITE_PUSHER_KEY=your_pusher_key
VITE_PUSHER_CLUSTER=your_pusher_cluster

# Supabase (finance app cloud storage)
# From your Supabase project: Settings > API Keys
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Use the PUBLISHABLE key (sb_publishable_...) — safe for the browser.
# Never put the SECRET key (sb_secret_...) in here: Vite bundles VITE_* vars into the frontend.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
